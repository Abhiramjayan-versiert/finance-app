rules_version = '2';

// FINANCE OS never accesses Firestore from the browser: every read and write
// goes through the authenticated Next.js server (Firebase Admin SDK), which
// scopes all paths to users/{uid} of the verified session. Denying all client
// access removes the entire class of client-side rule bypasses.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
