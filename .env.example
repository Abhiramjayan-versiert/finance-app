# ---------------------------------------------------------------------------
# FINANCE OS — environment variables
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings → API). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Use the "anon" key (or the newer "publishable" key — either variable works).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of the deployment (no trailing slash). Used for auth email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER ONLY — bypasses RLS. Used for admin actions, rate limiting, error
# logging, account deletion and cron jobs. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# SUPABASE_SECRET_KEY=

# SERVER ONLY — protects /api/cron/daily. Vercel Cron sends it automatically
# as "Authorization: Bearer <CRON_SECRET>". Generate: openssl rand -hex 32
CRON_SECRET=

# OPTIONAL — email notifications via Resend (https://resend.com).
RESEND_API_KEY=
# Verified sender, e.g. "FINANCE OS <notifications@yourdomain.com>"
EMAIL_FROM=

# Used by `npm run test:db` only (local PostgreSQL for RLS tests).
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
