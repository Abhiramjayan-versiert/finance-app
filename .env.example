# ---------------------------------------------------------------------------
# FINANCE OS — environment variables (Firebase + Vercel)
# Copy to .env.local for local development. Never commit real values.
# All of these are SERVER-ONLY; the browser never talks to Firebase directly.
# ---------------------------------------------------------------------------

# Firebase console → Project settings → General → "Web API key"
FIREBASE_WEB_API_KEY=

# Firebase console → Project settings → Service accounts → Generate new private key.
# Copy these three fields from the downloaded JSON file.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value including BEGIN/END lines (\n escapes are fine).
FIREBASE_PRIVATE_KEY=

# Public URL of the deployment (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects /api/cron/daily (Vercel Cron sends it automatically). openssl rand -hex 32
CRON_SECRET=

# Optional: HMAC key for 6-digit email codes (defaults to a value derived from the private key).
OTP_SECRET=

# Optional — Resend (https://resend.com). When set, sign-up and password reset use
# 6-digit email codes and notification emails are enabled. When not set, Firebase
# sends its own verification / reset links (free, no extra setup).
RESEND_API_KEY=
# Verified sender, e.g. "FINANCE OS <notifications@yourdomain.com>"
EMAIL_FROM=
